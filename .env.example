# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Klucz API: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Nazwa modelu z https://openrouter.ai/models, np. dostawca/model
OPENROUTER_MODEL=
# (Opcjonalnie) model do generowania obrazów; domyślnie google/gemini-3.1-flash-image (Nano Banana 2)
OPENROUTER_IMAGE_MODEL=
# Hasło warsztatowe do wejścia na czat
CHAT_PASSWORD=
# Losowy sekret do podpisu sesji (min. 32 znaki), generowany lokalnie
SESSION_SECRET=

# --- Limity agenta (lekcja 4, W2). Pusta/zła wartość = domyślna. ---
# Kroki modelu na jedno zadanie (domyślnie 6).
AGENT_MAX_STEPS=6
# Wywołania narzędzi na jedno zadanie, liczone osobno od kroków (domyślnie 16)
AGENT_MAX_TOOL_CALLS=16
# Czas całego zadania w sekundach (domyślnie 60, maks. 85)
AGENT_MAX_TASK_SECONDS=60
# Ile czeka jedna próba zapytania do API, w sekundach (domyślnie 6)
AGENT_TOOL_TIMEOUT_SECONDS=6
# To samo dla wolnych narzędzi: generujObraz, wyszukajWInternecie (domyślnie 40)
AGENT_SLOW_TOOL_TIMEOUT_SECONDS=40
# Ile razy ponowić zapytanie API po błędzie sieci, 5xx albo braku odpowiedzi (domyślnie 1)
AGENT_TOOL_RETRIES=1
# Jak długo pamiętać kurs NBP, w minutach; NBP publikuje raz dziennie (domyślnie 60, 0 = bez pamięci)
AGENT_NBP_CACHE_MINUTES=60


# supabase: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_SECRET_KEY=    
