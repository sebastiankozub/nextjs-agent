# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Klucz API: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Nazwa modelu z https://openrouter.ai/models, np. dostawca/model
OPENROUTER_MODEL=
# Hasło warsztatowe do wejścia na czat
CHAT_PASSWORD=
# Losowy sekret do podpisu sesji (min. 32 znaki), generowany lokalnie
SESSION_SECRET=
